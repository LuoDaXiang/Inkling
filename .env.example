# Live 测试配置。复制成 .env.local 再填写；.env.local 不会进仓库。
# 不配置时 `npm run test:live` 自动跳过，而不是失败。
#
# 获取方式：Azure 门户 → 创建 Speech 资源 → 「密钥和终结点」页面
# 免费层 F0 每月 50 万字符神经语音合成额度。

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# 可选，默认 en-US-AvaNeural
AZURE_TTS_VOICE=

# 计费费率，单位微元（百万分之一美元）。不配就不记花费——
# 流水里 cost_micros 留空，而不是记 0。「没配费率」和「确实免费」要分得开。
#
# 这两个数**必须按你自己的 Azure 定价页和账单核对**：它随定价层级、
# 区域、以及你的具体合同变化。下面的数量级仅供参考，不是承诺。
#
#   $16 / 100 万字符  → TTS_MICROS_PER_MILLION_CHARS=16000000
#   $1  / 小时音频    → SCORING_MICROS_PER_AUDIO_HOUR=1000000
TTS_MICROS_PER_MILLION_CHARS=
SCORING_MICROS_PER_AUDIO_HOUR=
