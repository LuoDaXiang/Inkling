{
  "name": "inkling",
  "version": "0.2.0",
  "private": true,
  "description": "A shadowing practice app for English learners",
  "license": "GPL-3.0-or-later",
  "author": "LuoXiang <luoxiang.xt@gmail.com>",
  "type": "module",
  "scripts": {
    "dev": "electron-forge start",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "test:live": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.tests.json",
    "test:coverage": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --coverage.enabled --coverage.include='src/**' --coverage.exclude='src/**/types.ts' --coverage.reporter=text",
    "validity": "node --env-file-if-exists=.env.local --import tsx scripts/assessment-validity.ts",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^44.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@divisey/js-mdict": "^5.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "next-themes": "^0.4.6",
    "pitchfinder": "^2.3.4",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "wavesurfer.js": "^7.12.11"
  },
  "main": ".vite/build/main.js"
}
